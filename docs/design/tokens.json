{
  "$schema_note": "Tokens Ovéa v1. Couleurs sRGB hex. Généré par script de contraste (WCAG 2.x).",
  "color": {
    "background": {
      "light": "#F8F5EF",
      "dark": "#121614",
      "description": "Fond d'écran (crème lin / nuit de sous-bois)"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1B201D",
      "description": "Cartes, listes groupées"
    },
    "surfaceMuted": {
      "light": "#EFEAE1",
      "dark": "#252C28",
      "description": "Chips au repos, champs, segments"
    },
    "surfaceRaised": {
      "light": "#FFFFFF",
      "dark": "#222825",
      "description": "Sheets, popovers (élévation 2)"
    },
    "separator": {
      "light": "#E2DCD1",
      "dark": "#323A35",
      "description": "Filets décoratifs (non porteurs de sens)"
    },
    "border": {
      "light": "#8A8276",
      "dark": "#7D8680",
      "description": "Contours de champs/contrôles (≥ 3:1)"
    },
    "textPrimary": {
      "light": "#1E2621",
      "dark": "#F0EDE6",
      "description": "Texte principal"
    },
    "textSecondary": {
      "light": "#566059",
      "dark": "#B4BBB5",
      "description": "Légendes, métadonnées"
    },
    "textTertiary": {
      "light": "#5F6661",
      "dark": "#959D97",
      "description": "Placeholders, aides (reste ≥ 4.5:1)"
    },
    "accent": {
      "light": "#3B6A55",
      "dark": "#8EC3A6",
      "description": "Sauge : boutons, liens, sélection, anneau « aujourd'hui »"
    },
    "onAccent": {
      "light": "#FFFFFF",
      "dark": "#0E2218",
      "description": "Texte/icône sur accent"
    },
    "accentSoft": {
      "light": "#E2ECE5",
      "dark": "#21362B",
      "description": "Fond chip sélectionnée, carte mise en avant"
    },
    "onAccentSoft": {
      "light": "#2A4F3F",
      "dark": "#AAD6BD",
      "description": "Texte sur accentSoft"
    },
    "highlight": {
      "light": "#A54F2E",
      "dark": "#EE9F7D",
      "description": "Terracotta : mise en avant ponctuelle (badge, illustration)"
    },
    "onHighlight": {
      "light": "#FFFFFF",
      "dark": "#2A1206",
      "description": "Texte sur highlight"
    },
    "highlightSoft": {
      "light": "#F6E5DB",
      "dark": "#3B251B",
      "description": "Fond terracotta doux"
    },
    "success": {
      "light": "#2D6A47",
      "dark": "#8DCB9F",
      "description": "Confirmation (« C'est noté »)"
    },
    "successSoft": {
      "light": "#E1EEE4",
      "dark": "#1E3426",
      "description": "Fond confirmation"
    },
    "warning": {
      "light": "#855600",
      "dark": "#E8BD69",
      "description": "Alerte douce (seuil 90 j, contre-indication)"
    },
    "warningSoft": {
      "light": "#FAEFD8",
      "dark": "#372C13",
      "description": "Fond alerte douce"
    },
    "info": {
      "light": "#2E5C78",
      "dark": "#90C1DE",
      "description": "Information, source, mention d'estimation"
    },
    "infoSoft": {
      "light": "#E2EDF3",
      "dark": "#1B2E39",
      "description": "Fond information"
    },
    "destructive": {
      "light": "#B3261E",
      "dark": "#FFB4AB",
      "description": "Suppression de données UNIQUEMENT (jamais une donnée corporelle)"
    },
    "period": {
      "light": "#9E3957",
      "dark": "#F097AF",
      "description": "Règles (toujours avec drop.fill + libellé)"
    },
    "onPeriod": {
      "light": "#FFFFFF",
      "dark": "#33101C",
      "description": "Texte sur period"
    },
    "periodSoft": {
      "light": "#F5E3E7",
      "dark": "#3C1E28",
      "description": "Fond jour de règles"
    },
    "spotting": {
      "light": "#B2647A",
      "dark": "#D99AAB",
      "description": "Spotting (contour, jamais seul)"
    },
    "miel": {
      "light": "#795610",
      "dark": "#E3BF72",
      "description": "Teinte miel"
    },
    "mielSoft": {
      "light": "#F6ECD3",
      "dark": "#382E17"
    },
    "olive": {
      "light": "#4A6220",
      "dark": "#B6CB86",
      "description": "Teinte olive"
    },
    "oliveSoft": {
      "light": "#E7EED8",
      "dark": "#2A321F"
    },
    "lagon": {
      "light": "#1E6662",
      "dark": "#80CAC7",
      "description": "Teinte lagon"
    },
    "lagonSoft": {
      "light": "#DBEEED",
      "dark": "#173434"
    },
    "ardoise": {
      "light": "#3C4E86",
      "dark": "#A9B6EB",
      "description": "Teinte ardoise"
    },
    "ardoiseSoft": {
      "light": "#E4E8F5",
      "dark": "#222A43"
    },
    "argile": {
      "light": "#984829",
      "dark": "#EDA585",
      "description": "Teinte argile"
    },
    "argileSoft": {
      "light": "#F7E5DB",
      "dark": "#3B251B"
    },
    "lavande": {
      "light": "#654F8E",
      "dark": "#C7B7E6",
      "description": "Teinte lavande"
    },
    "lavandeSoft": {
      "light": "#ECE6F5",
      "dark": "#2D273E"
    }
  },
  "colorAliases": {
    "meal.breakfast": "miel",
    "meal.lunch": "olive",
    "meal.dinner": "ardoise",
    "meal.snack": "argile",
    "activity.strength": "argile",
    "activity.cardio": "miel",
    "activity.mobility": "lagon",
    "activity.breathing": "lavande",
    "activity.intervals": "ardoise"
  },
  "colorHighContrast": {
    "textSecondary": {
      "light": "#3F4842",
      "dark": "#D2D8D3"
    },
    "border": {
      "light": "#5E574D",
      "dark": "#A3ACA6"
    },
    "accent": {
      "light": "#2C5442",
      "dark": "#A9DABF"
    },
    "period": {
      "light": "#7E2643",
      "dark": "#F7B8C9"
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "screenMargin": 20,
    "cardPadding": 16,
    "sectionGap": 32,
    "minTapTarget": 44
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "capsule": 999,
    "_note": "RoundedRectangle(style: .continuous) partout"
  },
  "elevation": {
    "0": {
      "light": "aucune",
      "dark": "aucune"
    },
    "1": {
      "light": {
        "color": "#2B3A30",
        "opacity": 0.06,
        "radius": 12,
        "y": 4,
        "plus": {
          "opacity": 0.04,
          "radius": 2,
          "y": 1
        }
      },
      "dark": {
        "shadow": "aucune",
        "surface": "surface",
        "stroke": "separator 0.5pt"
      }
    },
    "2": {
      "light": {
        "color": "#2B3A30",
        "opacity": 0.1,
        "radius": 24,
        "y": 8
      },
      "dark": {
        "shadow": "aucune",
        "surface": "surfaceRaised",
        "stroke": "separator 0.5pt"
      }
    }
  },
  "typography": {
    "_note": "Dynamic Type uniquement. design=serif => New York ; default => SF Pro ; rounded => SF Pro Rounded.",
    "display": {
      "textStyle": "largeTitle",
      "design": "serif",
      "weight": "semibold"
    },
    "title1": {
      "textStyle": "title",
      "design": "serif",
      "weight": "semibold"
    },
    "title2": {
      "textStyle": "title2",
      "design": "serif",
      "weight": "semibold"
    },
    "title3": {
      "textStyle": "title3",
      "design": "default",
      "weight": "semibold"
    },
    "headline": {
      "textStyle": "headline",
      "design": "default",
      "weight": "semibold"
    },
    "body": {
      "textStyle": "body",
      "design": "default",
      "weight": "regular"
    },
    "bodyEmphasis": {
      "textStyle": "body",
      "design": "default",
      "weight": "medium"
    },
    "callout": {
      "textStyle": "callout",
      "design": "default",
      "weight": "regular"
    },
    "subheadline": {
      "textStyle": "subheadline",
      "design": "default",
      "weight": "regular"
    },
    "footnote": {
      "textStyle": "footnote",
      "design": "default",
      "weight": "regular"
    },
    "caption": {
      "textStyle": "caption",
      "design": "default",
      "weight": "medium"
    },
    "overline": {
      "textStyle": "caption2",
      "design": "default",
      "weight": "semibold",
      "tracking": 0.6,
      "case": "uppercase"
    },
    "quote": {
      "textStyle": "title3",
      "design": "serif",
      "weight": "regular",
      "italic": true
    },
    "timer": {
      "baseSize": 72,
      "relativeTo": "largeTitle",
      "design": "rounded",
      "weight": "light",
      "monospacedDigit": true
    },
    "metric": {
      "textStyle": "title2",
      "design": "rounded",
      "weight": "semibold",
      "monospacedDigit": true
    }
  },
  "motion": {
    "standard": {
      "type": "spring",
      "duration": 0.35,
      "bounce": 0.0
    },
    "gentle": {
      "type": "easeInOut",
      "duration": 0.25
    },
    "reduceMotion": "opacity uniquement"
  }
}
