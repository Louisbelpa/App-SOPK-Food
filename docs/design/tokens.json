    },
    "2": {
      "light": {
        "color": "#5C341C",
        "opacity": 0.12,
        "radius": 32,
        "y": 12
      },
      "dark": {
        "color": "#000000",
        "opacity": 0.4,
        "radius": 28,
        "y": 10,
        "surface": "surfaceRaised"
      }
    }
